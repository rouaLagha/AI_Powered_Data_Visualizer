      <column caption='SalesDisplay' datatype='string' name='[SalesDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmount]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='Quota %' datatype='real' name='[SalesQuotaPct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE ZN(SUM([SalesAmount])) / ZN(SUM([SalesAmountQuota])) END' />
      </column>
      <column datatype='string' name='[SalesTerritoryCountry]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
