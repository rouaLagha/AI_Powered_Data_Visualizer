      <column aggregation='Sum' datatype='integer' name='[SalesTerritoryKey]' role='dimension' type='ordinal' />
      <column caption='SalesVariancePctDisplay' datatype='string' name='[SalesVariancePctDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN &quot;0.00%&quot; ELSE STR(ROUND(((ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])))*100,2)) + &quot;%&quot; END' />
      </column>
      <column caption='Variance %' datatype='real' name='[SalesVariancePct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE (ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])) END' />
      </column>
      <column caption='Variance' datatype='real' name='[SalesVariance]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([SalesAmount]) - ZN([SalesAmountQuota])' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[ShipDateKey]' role='dimension' type='ordinal' />
      <column caption='TitleTile' datatype='string' name='[TitleTileText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='VarianceDisplay' datatype='string' name='[VarianceDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesVariance]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
