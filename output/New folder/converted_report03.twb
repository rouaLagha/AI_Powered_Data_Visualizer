    <worksheet name='tablixRegionSummary_GaugeLabel'>
      <table>
        <view>
          <datasources>
            <datasource name='EnterData' />
          </datasources>
          <datasource-dependencies datasource='EnterData'>
            <column datatype='real' name='[SalesAmountQuota]' role='measure' type='quantitative' />
            <column datatype='real' name='[SalesAmount]' role='measure' type='quantitative' />
            <column caption='Variance %' datatype='real' name='[SalesVariancePct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE (ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])) END' />
            </column>
            <column-instance column='[SalesVariancePct]' derivation='Sum' name='[sum:SalesVariancePct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
