        <calculation class='tableau' formula='&quot;ORDERS     SALES     QUOTA     VARIANCE&quot;' />
      </column>
      <column caption='KPIHeaderVariance' datatype='string' name='[KPIHeaderVariance]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;VARIANCE&quot;' />
      </column>
      <column caption='MonthSortOrder' datatype='integer' name='[MonthSortOrder]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE LOWER([EnglishMonthName]) WHEN &quot;january&quot; THEN 1 WHEN &quot;february&quot; THEN 2 WHEN &quot;march&quot; THEN 3 WHEN &quot;april&quot; THEN 4 WHEN &quot;may&quot; THEN 5 WHEN &quot;june&quot; THEN 6 WHEN &quot;july&quot; THEN 7 WHEN &quot;august&quot; THEN 8 WHEN &quot;september&quot; THEN 9 WHEN &quot;october&quot; THEN 10 WHEN &quot;november&quot; THEN 11 WHEN &quot;december&quot; THEN 12 ELSE 99 END' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[OrderDateKey]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[ProductKey]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[PromotionKey]' role='dimension' type='ordinal' />
      <column caption='QuantityDisplay' datatype='string' name='[QuantityDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(ZN(SUM([OrderQuantity]))))' />
      </column>
      <column caption='QuotaDisplay' datatype='string' name='[QuotaDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmountQuota]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='ReportLogo' datatype='string' name='[ReportLogoLabel]' role='dimension' type='nominal'>
