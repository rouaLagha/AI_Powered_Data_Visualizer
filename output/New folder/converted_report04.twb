					<pane>
						<view>
							<breakdown value="auto" />
						</view>
						<mark class="Text" />
						<encodings>
							<text column="[EnterData].[attr:ReportSubtitleText:nk]" />
						</encodings>
					</pane>
				</panes>
				<rows></rows>
				<cols></cols>
			</table>
