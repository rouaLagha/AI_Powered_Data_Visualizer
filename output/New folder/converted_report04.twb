<workbook version="18.1" source-build="2024.2.0 (20242.24.0620.1454)" source-platform="win">
	<preferences />
	<style />
	<datasources>
		<datasource name="EnterData" caption="EnterData" inline="true" hasconnection="true">
			<connection class="federated">
				<named-connections>
					<named-connection name="sqlserver.enterdata" caption="DESKTOP-GC2J9J1\SQLEXPRESS">
						<connection class="sqlserver" server="DESKTOP-GC2J9J1\SQLEXPRESS" dbname="AdventureWorksDW2022" authentication="sspi" />
					</named-connection>
				</named-connections>
				<relation type="join" join="inner">
					<clause type="join">
						<expression op="=">
							<expression op="[DimDate].[DateKey]" />
							<expression op="[FactSalesQuota].[DateKey]" /></expression>
					</clause>
					<relation type="join" join="inner">
						<clause type="join">
							<expression op="=">
								<expression op="[FactResellerSales].[OrderDateKey]" />
								<expression op="[DimDate].[DateKey]" /></expression>
						</clause>
						<relation type="join" join="inner">
							<clause type="join">
								<expression op="=">
									<expression op="[FactResellerSales].[SalesTerritoryKey]" />
									<expression op="[DimSalesTerritory].[SalesTerritoryKey]" /></expression>
							</clause>
							<relation connection="sqlserver.enterdata" name="FactResellerSales" table="[dbo].[FactResellerSales]" type="table" />
							<relation connection="sqlserver.enterdata" name="DimSalesTerritory" table="[dbo].[DimSalesTerritory]" type="table" /></relation>
						<relation connection="sqlserver.enterdata" name="DimDate" table="[dbo].[DimDate]" type="table" /></relation>
					<relation connection="sqlserver.enterdata" name="FactSalesQuota" table="[dbo].[FactSalesQuota]" type="table" /></relation>
				<cols>
					<map key="[OrderQuantity]" value="[FactResellerSales].[OrderQuantity]" />
					<map key="[SalesAmount]" value="[FactResellerSales].[SalesAmount]" />
					<map key="[SalesTerritoryGroup]" value="[DimSalesTerritory].[SalesTerritoryGroup]" />
					<map key="[EnglishMonthName]" value="[DimDate].[EnglishMonthName]" />
					<map key="[SalesAmountQuota]" value="[FactSalesQuota].[SalesAmountQuota]" />
					<map key="[CalendarYear]" value="[DimDate].[CalendarYear]" />
				</cols>
			</connection>
			<column name="[OrderQuantity]" role="measure" datatype="real" type="quantitative" />
			<column name="[SalesAmount]" role="measure" datatype="real" type="quantitative" />
			<column name="[SalesTerritoryGroup]" role="dimension" datatype="string" type="nominal" />
			<column name="[EnglishMonthName]" role="dimension" datatype="string" type="nominal" />
			<column name="[SalesAmountQuota]" role="measure" datatype="real" type="quantitative" />
			<column name="[SalesVariance]" role="measure" datatype="real" type="quantitative" caption="Variance">
				<calculation class="tableau" formula="ZN([SalesAmount]) - ZN([SalesAmountQuota])" />
			</column>
			<column name="[SalesVariancePct]" role="measure" datatype="real" type="quantitative" caption="Variance %">
				<calculation class="tableau" formula="IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE (ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])) END" />
			</column>
			<column name="[ReportLogoLabel]" role="dimension" datatype="string" type="nominal" caption="ReportLogo">
				<calculation class="tableau" formula="&quot;ID16313774731791&quot;" />
			</column>
			<column name="[TitleTileText]" role="dimension" datatype="string" type="nominal" caption="TitleTile">
				<calculation class="tableau" formula="&quot;&quot;" />
			</column>
			<column name="[ReportTitleText]" role="dimension" datatype="string" type="nominal" caption="ReportTitle">
				<calculation class="tableau" formula="&quot;Regional Sales&quot;" />
			</column>
			<column name="[ReportSubtitleText]" role="dimension" datatype="string" type="nominal" caption="ReportSubtitle">
				<calculation class="tableau" formula="&quot;Year: &quot; + (IF MIN([CalendarYear]) = MAX([CalendarYear]) THEN STR(INT(MIN([CalendarYear]))) ELSE &quot;All&quot; END) + &quot; | Group: &quot; + (IF MIN([SalesTerritoryGroup]) = MAX([SalesTerritoryGroup]) THEN MIN([SalesTerritoryGroup]) ELSE &quot;All&quot; END)" />
			</column>
			<column name="[KPIHeaderText]" role="dimension" datatype="string" type="nominal" caption="KPIHeaders">
				<calculation class="tableau" formula="&quot;ORDERS     SALES     QUOTA     VARIANCE&quot;" />
			</column>
			<column name="[FooterRunAtText]" role="dimension" datatype="string" type="nominal" caption="FooterRunAt">
				<calculation class="tableau" formula="&quot;Run at &quot; + STR(NOW())" />
			</column>
			<column name="[FooterPageText]" role="dimension" datatype="string" type="nominal" caption="FooterPage">
				<calculation class="tableau" formula="&quot;Page 1 of 1&quot;" />
			</column>
			<column name="[SalesQuotaPct]" role="measure" datatype="real" type="quantitative" caption="Quota %">
				<calculation class="tableau" formula="IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE ZN(SUM([SalesAmount])) / ZN(SUM([SalesAmountQuota])) END" />
			</column>
			<column name="[MonthSortOrder]" role="dimension" datatype="real" type="ordinal" caption="MonthSortOrder">
				<calculation class="tableau" formula="CASE LOWER([EnglishMonthName]) WHEN &quot;january&quot; THEN 1 WHEN &quot;february&quot; THEN 2 WHEN &quot;march&quot; THEN 3 WHEN &quot;april&quot; THEN 4 WHEN &quot;may&quot; THEN 5 WHEN &quot;june&quot; THEN 6 WHEN &quot;july&quot; THEN 7 WHEN &quot;august&quot; THEN 8 WHEN &quot;september&quot; THEN 9 WHEN &quot;october&quot; THEN 10 WHEN &quot;november&quot; THEN 11 WHEN &quot;december&quot; THEN 12 ELSE 99 END" />
			</column>
			<column name="[QuantityDisplay]" role="dimension" datatype="string" type="nominal" caption="QuantityDisplay">
				<calculation class="tableau" formula="STR(INT(ZN(SUM([OrderQuantity]))))" />
			</column>
			<column name="[SalesDisplay]" role="dimension" datatype="string" type="nominal" caption="SalesDisplay">
				<calculation class="tableau" formula="&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmount]))/1000000,3)) + &quot; M&quot;" />
			</column>
			<column name="[QuotaDisplay]" role="dimension" datatype="string" type="nominal" caption="QuotaDisplay">
				<calculation class="tableau" formula="&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmountQuota]))/1000000,3)) + &quot; M&quot;" />
			</column>
			<column name="[VarianceDisplay]" role="dimension" datatype="string" type="nominal" caption="VarianceDisplay">
				<calculation class="tableau" formula="&quot;$&quot; + STR(ROUND(ZN(SUM([SalesVariance]))/1000000,3)) + &quot; M&quot;" />
			</column>
			<column name="[SalesVariancePctDisplay]" role="dimension" datatype="string" type="nominal" caption="SalesVariancePctDisplay">
				<calculation class="tableau" formula="IF ZN(SUM([SalesAmountQuota])) = 0 THEN &quot;0.00%&quot; ELSE STR(ROUND(((ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])))*100,2)) + &quot;%&quot; END" />
			</column>
			<column name="[KPIHeaderOrders]" role="dimension" datatype="string" type="nominal" caption="KPIHeaderOrders">
				<calculation class="tableau" formula="&quot;ORDERS&quot;" />
			</column>
			<column name="[KPIHeaderSales]" role="dimension" datatype="string" type="nominal" caption="KPIHeaderSales">
				<calculation class="tableau" formula="&quot;SALES&quot;" />
			</column>
			<column name="[KPIHeaderQuota]" role="dimension" datatype="string" type="nominal" caption="KPIHeaderQuota">
				<calculation class="tableau" formula="&quot;QUOTA&quot;" />
			</column>
			<column name="[KPIHeaderVariance]" role="dimension" datatype="string" type="nominal" caption="KPIHeaderVariance">
				<calculation class="tableau" formula="&quot;VARIANCE&quot;" />
			</column>
			<column name="[CalendarYear]" role="dimension" datatype="integer" type="quantitative" />
			<layout dim-ordering="alphabetic" measure-ordering="alphabetic" dim-percentage="0.50" measure-percentage="0.50" show-structure="true" />
			<style />
		</datasource>
	</datasources>
