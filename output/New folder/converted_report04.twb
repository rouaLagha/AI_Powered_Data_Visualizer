			<layout-options />
			<table>
				<view>
					<datasources>
						<datasource name="EnterData" />
					</datasources>
					<datasource-dependencies datasource="EnterData">
						<column name="[ReportSubtitleText]" role="dimension" datatype="string" type="nominal" caption="ReportSubtitleText">
							<calculation class="tableau" formula="&quot;Year: &quot; + IFNULL((IF MIN([CalendarYear]) = MAX([CalendarYear]) THEN STR(INT(MIN([CalendarYear]))) ELSE &quot;All&quot; END),&quot;All&quot;) + &quot; | Group: &quot; + IFNULL((IF MIN([SalesTerritoryGroup]) = MAX([SalesTerritoryGroup]) THEN MIN([SalesTerritoryGroup]) ELSE &quot;All&quot; END),&quot;All&quot;)" />
						</column>
						<column-instance column="[ReportSubtitleText]" derivation="Attribute" name="[attr:ReportSubtitleText:nk]" pivot="key" type="nominal" />
						<column name="[CalendarYear]" role="dimension" datatype="integer" type="quantitative" caption="CalendarYear" />
						<column-instance column="[CalendarYear]" derivation="None" name="[none:CalendarYear:qk]" pivot="key" type="quantitative" />
						<column name="[SalesTerritoryGroup]" role="dimension" datatype="string" type="nominal" caption="SalesTerritoryGroup" />
						<column-instance column="[SalesTerritoryGroup]" derivation="None" name="[none:SalesTerritoryGroup:nk]" pivot="key" type="nominal" />
					</datasource-dependencies>
					<filter class="quantitative" column="[EnterData].[none:CalendarYear:qk]" included-values="in-range-or-null">
						<min>0</min>
						<max>9999</max>
					</filter>
					<filter class="categorical" column="[EnterData].[none:SalesTerritoryGroup:nk]">
						<groupfilter function="level-members" level="[none:SalesTerritoryGroup:nk]" />
					</filter>
					<slices>
						<column>[EnterData].[none:CalendarYear:qk]</column>
						<column>[EnterData].[none:SalesTerritoryGroup:nk]</column>
					</slices>
					<aggregation value="true" />
				</view>
				<style />
