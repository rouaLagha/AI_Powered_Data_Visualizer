  "datasets": [
    {
      "name": "dsMain",
      "data_source_name": "EnterData",
      "query": "SELECT\n    dc.DateKey AS MonthKey,\n    dc.EnglishMonthName AS Month,\n    dst.SalesTerritoryGroup AS SalesTerritoryRegion,\n    SUM(fs.SalesAmount) AS Sales,\n    SUM(fs.OrderQuantity) AS Quantity,\n    SUM(fsq.SalesAmountQuota) AS Quota\nFROM FactResellerSales fs\nJOIN DimSalesTerritory dst\n    ON fs.SalesTerritoryKey = dst.SalesTerritoryKey\nJOIN DimDate dc\n    ON fs.OrderDateKey = dc.DateKey\nJOIN FactSalesQuota fsq\n    ON fsq.DateKey = dc.DateKey\nGROUP BY\n    dc.DateKey,\n    dc.EnglishMonthName,\n    dst.SalesTerritoryGroup\nORDER BY\n    dc.DateKey,\n    dst.SalesTerritoryGroup;",
      "query_parameters": [],
      "filters": [
        {
          "expression": "=Fields!SalesTerritoryRegion.Value",
          "operator": "Equal",
          "values": [
            "=Parameters!SalesTerritoryGroup.Value"
          ],
          "data_type": null,
          "parameter_references": [
            "SalesTerritoryGroup"
          ]
        }
      ],
      "sort_expressions": []
    },
    {
      "name": "dsParamYear",
      "data_source_name": "EnterData",
      "query": "SELECT DISTINCT\n    dc.CalendarYear\nFROM DimDate dc\nORDER BY\n    dc.CalendarYear DESC;",
      "query_parameters": [],
      "filters": [],
      "sort_expressions": []
    },
    {
      "name": "dsParamSalesTerritoryGroup",
      "data_source_name": "EnterData",
      "query": "SELECT DISTINCT\n    dst.SalesTerritoryGroup\nFROM DimSalesTerritory dst\nORDER BY\n    dst.SalesTerritoryGroup;",
      "query_parameters": [],
      "filters": [],
      "sort_expressions": []
    }
  ],
