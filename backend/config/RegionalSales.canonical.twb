        <rows>([EnterData].[sum:SalesAmount:qk] + [EnterData].[sum:SalesAmountQuota:qk])</rows>
        <cols>[EnterData].[none:EnglishMonthName:nk]</cols>
      </table>
      <simple-id uuid='{20BB5DC9-0095-4C23-95B6-140AC99E00D6}' />
    </worksheet>
    <worksheet name='tablixRegionSummary_GaugeLabel'>
      <table>
        <view>
          <datasources>
            <datasource name='EnterData' />
          </datasources>
          <datasource-dependencies datasource='EnterData'>
            <column datatype='real' name='[SalesAmountQuota]' role='measure' type='quantitative' />
            <column datatype='real' name='[SalesAmount]' role='measure' type='quantitative' />
            <column caption='Variance %' datatype='real' name='[SalesVariancePct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE (ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])) END' />
            </column>
            <column-instance column='[SalesVariancePct]' derivation='Sum' name='[sum:SalesVariancePct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[EnterData].[sum:SalesVariancePct:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols>[EnterData].[sum:SalesVariancePct:qk]</cols>
      </table>
      <simple-id uuid='{2EFADCE5-C48D-4C26-B52C-E5C567ACDDDB}' />
    </worksheet>
    <worksheet name='tablixRegionSummary_GaugePanel1'>
      <table>
        <view>
          <datasources>
            <datasource name='EnterData' />
          </datasources>
          <datasource-dependencies datasource='EnterData'>
            <column datatype='integer' name='[CalendarYear]' role='dimension' type='quantitative' />
            <column datatype='real' name='[SalesAmountQuota]' role='measure' type='quantitative' />
            <column datatype='real' name='[SalesAmount]' role='measure' type='quantitative' />
            <column caption='Quota %' datatype='real' name='[SalesQuotaPct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 &#13;&#10;ELSE (((SUM(ZN([SalesAmount])))-SUM([SalesAmountQuota])) / SUM(ZN([SalesAmountQuota]))) * 100000&#13;&#10;END' />
            </column>
            <column datatype='string' name='[SalesTerritoryGroup]' role='dimension' type='nominal' />
            <column-instance column='[CalendarYear]' derivation='None' name='[none:CalendarYear:qk]' pivot='key' type='quantitative' />
            <column-instance column='[SalesTerritoryGroup]' derivation='None' name='[none:SalesTerritoryGroup:nk]' pivot='key' type='nominal' />
            <column-instance column='[SalesQuotaPct]' derivation='User' name='[usr:SalesQuotaPct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[EnterData].[none:CalendarYear:qk]' included-values='in-range'>
            <min>2013</min>
            <max>2014</max>
          </filter>
          <filter class='categorical' column='[EnterData].[none:SalesTerritoryGroup:nk]'>
            <groupfilter function='member' level='[none:SalesTerritoryGroup:nk]' member='&quot;Europe&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[EnterData].[none:SalesTerritoryGroup:nk]</column>
            <column>[EnterData].[none:CalendarYear:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
