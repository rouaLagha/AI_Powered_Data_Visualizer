        <calculation class='tableau' formula='&quot;Page 1 of 1&quot;' />
      </column>
      <column caption='FooterRunAt' datatype='string' name='[FooterRunAtText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Run at &quot; + STR(NOW())' />
      </column>
      <column caption='KPIHeaderOrders' datatype='string' name='[KPIHeaderOrders]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;ORDERS&quot;' />
      </column>
      <column caption='KPIHeaderQuota' datatype='string' name='[KPIHeaderQuota]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;QUOTA&quot;' />
      </column>
      <column caption='KPIHeaderSales' datatype='string' name='[KPIHeaderSales]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;SALES&quot;' />
      </column>
      <column caption='KPIHeaders' datatype='string' name='[KPIHeaderText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;ORDERS     SALES     QUOTA     VARIANCE&quot;' />
      </column>
      <column caption='KPIHeaderVariance' datatype='string' name='[KPIHeaderVariance]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;VARIANCE&quot;' />
      </column>
      <column caption='MonthSortOrder' datatype='integer' name='[MonthSortOrder]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE LOWER([EnglishMonthName]) WHEN &quot;january&quot; THEN 1 WHEN &quot;february&quot; THEN 2 WHEN &quot;march&quot; THEN 3 WHEN &quot;april&quot; THEN 4 WHEN &quot;may&quot; THEN 5 WHEN &quot;june&quot; THEN 6 WHEN &quot;july&quot; THEN 7 WHEN &quot;august&quot; THEN 8 WHEN &quot;september&quot; THEN 9 WHEN &quot;october&quot; THEN 10 WHEN &quot;november&quot; THEN 11 WHEN &quot;december&quot; THEN 12 ELSE 99 END' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[OrderDateKey]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[ProductKey]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[PromotionKey]' role='dimension' type='ordinal' />
      <column caption='QuantityDisplay' datatype='string' name='[QuantityDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(ZN(SUM([OrderQuantity]))))' />
      </column>
      <column caption='QuotaDisplay' datatype='string' name='[QuotaDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmountQuota]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='ReportLogo' datatype='string' name='[ReportLogoLabel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;ID16313774731791&quot;' />
      </column>
      <column caption='ReportSubtitle' datatype='string' name='[ReportSubtitleText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Year: [@CalendarYear] | Group: [@SalesTerritoryGroup]&quot;' />
      </column>
      <column caption='ReportTitle' datatype='string' name='[ReportTitleText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Regional Sales&quot;' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[ResellerKey]' role='dimension' type='ordinal' />
      <column datatype='real' name='[SalesAmountQuota]' role='measure' type='quantitative' />
      <column datatype='real' name='[SalesAmount]' role='measure' type='quantitative' />
      <column caption='SalesDisplay' datatype='string' name='[SalesDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesAmount]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='Quota %' datatype='real' name='[SalesQuotaPct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 &#13;&#10;ELSE (((SUM(ZN([SalesAmount])))-SUM([SalesAmountQuota])) / SUM(ZN([SalesAmountQuota]))) * 100000&#13;&#10;END' />
      </column>
      <column datatype='string' name='[SalesTerritoryCountry]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[SalesTerritoryKey (DimSalesTerritory)]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[SalesTerritoryKey]' role='dimension' type='ordinal' />
      <column caption='SalesVariancePctDisplay' datatype='string' name='[SalesVariancePctDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN &quot;0.00%&quot; ELSE STR(ROUND(((ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])))*100,2)) + &quot;%&quot; END' />
      </column>
      <column caption='Variance %' datatype='real' name='[SalesVariancePct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(SUM([SalesAmountQuota])) = 0 THEN 0 ELSE (ZN(SUM([SalesAmount])) - ZN(SUM([SalesAmountQuota]))) / ZN(SUM([SalesAmountQuota])) END' />
      </column>
      <column caption='Variance' datatype='real' name='[SalesVariance]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([SalesAmount]) - ZN([SalesAmountQuota])' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[ShipDateKey]' role='dimension' type='ordinal' />
      <column caption='TitleTile' datatype='string' name='[TitleTileText]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='VarianceDisplay' datatype='string' name='[VarianceDisplay]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(ZN(SUM([SalesVariance]))/1000000,3)) + &quot; M&quot;' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column-instance column='[SalesAmount]' derivation='Sum' name='[sum:SalesAmount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[SalesAmountQuota]' derivation='Sum' name='[sum:SalesAmountQuota:qk]' pivot='key' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[:Measure Names]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;[EnterData].[sum:SalesAmount:qk]&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;[EnterData].[sum:SalesAmountQuota:qk]&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;France&quot;' />
      </semantic-values>
