      "report_content_crop": {
        "top_ratio": 0,
        "bottom_ratio": 0,
        "left_ratio": 0,
        "right_ratio": 0
      }
    },
    "data_tests": {
      "enabled": true,
      "numeric_tolerance_percent": 1.0,
      "minor_delta_tolerance_percent": 5.0,
      "strict_missing_values": false,
      "required_kpis": ["orders", "sales", "quota", "variance"],
      "required_chart_categories": ["March", "June", "September"],
      "screenshot_ocr": {
        "enabled": true,
        "psm": "6"
      },
      "screenshot_vision": {
        "enabled": true,
