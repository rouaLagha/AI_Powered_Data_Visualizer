            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
            <encodings>
              <wedge-size column='[EnterData].[usr:SalesQuotaPct:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
